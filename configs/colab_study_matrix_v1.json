{
  "schema": "esc50_colab_study_v1",
  "scope": "development-validation only; held-out test access disabled",
  "train_protocol": {
    "train_folds": [
      1,
      2,
      3
    ],
    "validation_fold": 4,
    "held_out_fold": 5,
    "source_strict": true,
    "seeds": [
      101,
      202,
      303
    ],
    "epochs": 60,
    "batch_size": 32,
    "learning_rate": 0.001,
    "scheduler": "cosine"
  },
  "groups": {
    "A_baselines": {
      "title": "Traditional baselines",
      "status": "runnable",
      "required": true
    },
    "B_architecture": {
      "title": "CNN/CRNN/Temporal+Channel Attention",
      "status": "runnable",
      "required": true
    },
    "C_augmentation": {
      "title": "SpecAugment / waveform noise / Mixup",
      "status": "runnable",
      "required": true
    },
    "D_feature_sampling": {
      "title": "12 feature x sample-rate cases; 3 seeds",
      "status": "runnable",
      "required": false
    },
    "E_robustness": {
      "title": "Development-validation only noise/gain stress",
      "status": "runnable",
      "required": false
    },
    "F_advanced": {
      "title": "PANNs / CLAP / BEATs / RL",
      "status": "not_implemented",
      "required": false
    },
    "G_confirmation": {
      "title": "Held-out test / final CV",
      "status": "manual_only_after_freeze",
      "required": false
    }
  },
  "not_executable": [
    {
      "name": "PANNs frozen/fine-tuned",
      "reason": "No integrated pretrained encoder/checkpoint or pretraining overlap audit"
    },
    {
      "name": "CLAP zero-shot",
      "reason": "No CLAP runtime/weights/text prompt protocol implemented"
    },
    {
      "name": "BEATs/AST",
      "reason": "No pretrained model backend and weights"
    },
    {
      "name": "Reinforcement learning",
      "reason": "Out of scope for current supervised ESC-50 study"
    },
    {
      "name": "Final held-out test / fixed CV",
      "reason": "Requires frozen recipe, protocol approval and disclosure of prior test access"
    }
  ],
